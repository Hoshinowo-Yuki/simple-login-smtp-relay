# Template — install with ./install-host-config.sh (fills in @STACK_DIR@).
# Bans IPs with repeated failed logins on the submission port (587).
[smtp-relay]
enabled  = true
filter   = postfix[mode=auth]
port     = submission
logpath  = @STACK_DIR@/logs/postfix.log
backend  = auto
maxretry = 5
findtime = 10m
bantime  = 1h

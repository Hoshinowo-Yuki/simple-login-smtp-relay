# Template — install with ./install-host-config.sh, which fills in the stack path.
# Bans IPs with repeated failed logins on the submission ports (587 STARTTLS, 465 implicit TLS).
[smtp-relay]
enabled  = true
filter   = postfix[mode=auth]
port     = submission,submissions
logpath  = @STACK_DIR@/logs/postfix.log
backend  = auto
maxretry = 5
findtime = 10m
bantime  = 1h

# Copy to .env (gitignored). Used by docker compose itself.

# Public name of the relay; must match the DNS record and the certificate
MYHOSTNAME=smtp.example.com

# --- Direct delivery (optional) ---------------------------------------------------
# Instead of an external mailbox, the relay can deliver straight to SimpleLogin's
# servers on port 25 (outbound port 25 must be open on your host). Needs reverse DNS,
# SPF, DKIM and DMARC for MYHOSTNAME; see README "Direct delivery".
# DKIM selector: set it, then `docker compose run --rm opendkim genkey`.
#DKIM_SELECTOR=relay
# Signing domain, default MYHOSTNAME (must match the address in UPSTREAM_FROM)
#DKIM_DOMAIN=
# yes = deliver over IPv4 only (e.g. while the IPv6 address has no reverse DNS)
#OUTBOUND_IPV4_ONLY=no

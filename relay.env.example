# Copy to relay.env (gitignored). Settings for the SimpleLogin relay script.

# Listener: only Postfix connects, over loopback (see docker-compose.yml)
RELAY_HOST=0.0.0.0
RELAY_PORT=8025

# Internal login used by Postfix; must match secrets/relay_login
RELAY_USERNAME=relay-internal
RELAY_PASSWORD=CHANGE_ME

# TLS is handled by Postfix (587 STARTTLS, 465 implicit TLS); the internal hop is loopback only
TLS_ENABLED=false
TLS_CERT=
TLS_KEY=

# SimpleLogin API (SL_API_TIMEOUT: seconds per API call)
SL_API_URL=https://app.simplelogin.io
SL_API_KEY=CHANGE_ME
SL_API_TIMEOUT=10

# Upstream mailbox (the address approved in SimpleLogin)
UPSTREAM_HOST=smtp.example.com
UPSTREAM_PORT=587
UPSTREAM_USERNAME=you@example.com
UPSTREAM_PASSWORD=CHANGE_ME
UPSTREAM_STARTTLS=true
# Send upstream as this address (envelope sender + From header). Recommended for every
# upstream: set it to the same address as UPSTREAM_USERNAME. REQUIRED for Proton Mail
# (only the token's own address may send). SimpleLogin must accept it for the aliases:
# add it as an authorized address on their mailbox (recommended), or as one of their mailboxes.
# Empty = pass the original sender through (works only where the upstream rewrites it, e.g. Gmail).
UPSTREAM_FROM=you@example.com

# Timeouts and logging
# DATA_TIMEOUT: deadline for the alias lookups; if passed before anything is sent
# upstream, the message is deferred (451) and Postfix retries later.
DATA_TIMEOUT=30
UPSTREAM_TIMEOUT=15
LOG_LEVEL=INFO
